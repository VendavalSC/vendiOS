def log(*a):
    print(time.strftime("%H:%M:%S"), *a, flush=True)


def notify(title, body=""):
    """A desktop notification in the invoking user's session."""
    user = os.environ.get("SUDO_USER")
    uid = os.environ.get("SUDO_UID")
    if not user or not uid:
        return
    subprocess.Popen(["sudo", "-u", user, "env", f"DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/{uid}/bus",
                      "notify-send", "-a", "Phone", "-i", "phone", title, body],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def load_state():
    try:
        return json.load(open(STATE_FILE))
    except Exception:
        return {}


def save_state(st):
    os.makedirs(os.path.dirname(STATE_FILE), exist_ok=True)
    json.dump(st, open(STATE_FILE, "w"), indent=1)


# ── bluetoothd takeover ──────────────────────────────────────────────────────

def systemctl(*args):
    subprocess.run(["systemctl", *args], check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def bt_takeover():
    os.makedirs(RUN, exist_ok=True)
    os.makedirs(DROPIN_DIR, exist_ok=True)
    try:
        conf = open("/etc/bluetooth/main.conf").read()
    except OSError:
        conf = "[General]\n"
    # (the device class stays "laptop": as a keyboard, iOS demands passkey
    # entry — typing a code shown on the phone — and rejects just-works
    # pairing with "Pairing Unsuccessful"; as a computer it pairs cleanly and
    # still uses the HID service below)
    open(os.path.join(RUN, "main.conf"), "w").write(conf)
    open(DROPIN, "w").write(
        "# vendi phone control is running — restored when it stops\n"
        "[Service]\nExecStart=\n"
        f"ExecStart=/usr/lib/bluetooth/bluetoothd -P input -f {RUN}/main.conf\n")
    systemctl("daemon-reload")
    systemctl("restart", "bluetooth")


def bt_restore():
    try:
        os.remove(DROPIN)
    except FileNotFoundError:
        pass
    systemctl("daemon-reload")
    systemctl("restart", "bluetooth")


