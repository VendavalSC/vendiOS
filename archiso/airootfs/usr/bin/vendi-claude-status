#!/usr/bin/env bash
# vendi-claude-status — feed Claude Code state to the vendiOS bar.
#
# Two modes:
#   • poll (no args, run by the bar every few seconds): auto-detects a running
#     Claude Code session from the most-recently-active transcript, computes the
#     context-window usage %, and reports the model. Prints STATE/MODEL/USAGE/VERB.
#   • hook (`vendi-claude-status hook working|idle [verb]`): records the
#     working/idle state for the poller (Claude Code hooks call this — the only
#     reliable "is it generating right now" signal). `vendi claude` wires these.
set -uo pipefail
HOOK="${HOME}/.config/vendi/claude-hook"
PROJ="${HOME}/.claude/projects"

if [[ "${1:-}" == "hook" ]]; then
    mkdir -p "$(dirname "$HOOK")"
    printf 'STATE=%s\nVERB=%s\nAT=%s\n' "${2:-idle}" "${3:-}" "$(date +%s)" > "$HOOK"
    exit 0
fi

# An active session = a transcript touched in the last 20 min (covers reading
# gaps between turns; a closed/stale session drops off and the gadget hides).
newest=$(find "$PROJ" -name '*.jsonl' -mmin -20 -printf '%T@ %p\n' 2>/dev/null \
         | sort -rn | head -1 | cut -d' ' -f2-)
[[ -z "$newest" ]] && { echo "STATE=off"; exit 0; }

# Model → short name.
mid=$(grep -o '"model":"[^"]*"' "$newest" | tail -1 | sed 's/.*:"//; s/"$//')
case "$mid" in
    *opus*)   model=Opus ;;   *sonnet*) model=Sonnet ;;
    *haiku*)  model=Haiku ;;  *fable*)  model=Fable ;;
    "")       model=Claude ;; *)        model=$mid ;;
esac

# Context usage %: last usage block → input + cache_creation + cache_read.
# Window is 200k normally, 1M once a session crosses 200k (the long-context mode).
u=$(grep -o '"usage":{[^}]*}' "$newest" | tail -1)
_n() { printf '%s' "$u" | grep -o "\"$1\":[0-9]*" | head -1 | grep -o '[0-9]*$'; }
it=$(_n input_tokens); cc=$(_n cache_creation_input_tokens); cr=$(_n cache_read_input_tokens)
ctx=$(( ${it:-0} + ${cc:-0} + ${cr:-0} ))
win=200000; (( ctx > 200000 )) && win=1000000
pct=$(( win > 0 ? ctx * 100 / win : 0 )); (( pct > 100 )) && pct=100

# Working/idle from the hook flag, if fresh (a hung "working" can't stick).
state=idle; verb=""
if [[ -r "$HOOK" ]]; then
    hs=$(grep -m1 '^STATE=' "$HOOK" | cut -d= -f2)
    hv=$(grep -m1 '^VERB='  "$HOOK" | cut -d= -f2)
    at=$(grep -m1 '^AT='    "$HOOK" | cut -d= -f2)
    if [[ "$hs" == working ]] && (( $(date +%s) - ${at:-0} <= 180 )); then
        state=working; verb=${hv:-Cooking}
    fi
fi

printf 'STATE=%s\nMODEL=%s\nUSAGE=%s%%\nVERB=%s\n' "$state" "$model" "$pct" "$verb"
