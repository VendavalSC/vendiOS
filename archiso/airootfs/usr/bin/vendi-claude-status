#!/usr/bin/env bash
# vendi-claude-status — feed Claude Code state to the vendiOS bar.
#
# Modes:
#   • poll (no args, run by the bar every few seconds): detects a running Claude
#     Code session, reports the real account-wide 5h usage % (Anthropic's
#     /api/oauth/usage — the same source as `/usage`; cached + refreshed in the
#     background so this never blocks), the model, and working/idle.
#   • hook working|idle [verb]: records the live working state (Claude Code hooks
#     call this — the one thing polling can't see). vendi-session installs them.
#   • refresh-usage: query the usage API, cache the %. Spawned by poll; detached.
set -uo pipefail
CFG="${HOME}/.config/vendi"
HOOK="${CFG}/claude-hook"
USAGE_CACHE="${CFG}/claude-usage"
CREDS="${HOME}/.claude/.credentials.json"

# ── hook mode ─────────────────────────────────────────────────────────────────
if [[ "${1:-}" == "hook" ]]; then
    mkdir -p "$CFG"
    printf 'STATE=%s\nVERB=%s\nAT=%s\n' "${2:-idle}" "${3:-}" "$(date +%s)" > "$HOOK"
    exit 0
fi

# ── usage refresh (background): the real 5h % from the account API ────────────
if [[ "${1:-}" == "refresh-usage" ]]; then
    [[ -r "$CREDS" ]] || exit 0
    tok=$(python3 -c "import json;print(json.load(open('$CREDS'))['claudeAiOauth']['accessToken'])" 2>/dev/null) || exit 0
    [[ -n "$tok" ]] || exit 0
    resp=$(curl -s -m 10 https://api.anthropic.com/api/oauth/usage \
        -H "Authorization: Bearer $tok" -H "anthropic-beta: oauth-2025-04-20" 2>/dev/null) || exit 0
    read -r five seven < <(printf '%s' "$resp" | python3 -c '
import json, sys
try: d = json.load(sys.stdin)
except Exception: sys.exit(0)
def u(k):
    v = (d.get(k) or {}).get("utilization")
    return str(round(v)) if v is not None else ""
print(u("five_hour"), u("seven_day"))
' 2>/dev/null)
    [[ -n "${five:-}" ]] || exit 0
    mkdir -p "$CFG"
    printf 'PCT=%s\nWEEK=%s\nAT=%s\n' "$five" "${seven:-}" "$(date +%s)" > "$USAGE_CACHE"
    exit 0
fi

# ── poll mode ─────────────────────────────────────────────────────────────────
# Session open = a claude process — either the bare `claude` binary (comm=claude)
# or a versioned session host — or, as a fallback, a transcript written in the
# last minute.
if ! pgrep -x claude >/dev/null 2>&1 \
   && ! pgrep -f 'claude/versions' >/dev/null 2>&1 \
   && [[ -z "$(find "$HOME/.claude/projects" -name '*.jsonl' -mmin -1 2>/dev/null | head -1)" ]]; then
    echo "STATE=off"; exit 0
fi
# A cmdline carrying --model (versioned launch) lets us read the model directly.
pcmd=$(pgrep -af 'claude' 2>/dev/null | grep -viE 'vendi-claude|claude-status|pgrep' | grep -- '--model' | head -1 || true)

# Model: from the running process's --model flag; else the newest transcript.
model=$(printf '%s' "$pcmd" | grep -oE -- '--model[= ]+[A-Za-z0-9._-]+' | head -1 | sed -E 's/--model[= ]+//')
if [[ -z "$model" ]]; then
    newest=$(find "$HOME/.claude/projects" -name '*.jsonl' -printf '%T@ %p\n' 2>/dev/null | sort -rn | head -1 | cut -d' ' -f2-)
    # skip synthetic / placeholder model entries (e.g. "<synthetic>")
    model=$(grep -o '"model":"[^"]*"' "$newest" 2>/dev/null | grep -vE 'synthetic|"<' | tail -1 | sed 's/.*:"//; s/"$//')
fi
# last resort: the configured model in settings.json (covers custom aliases)
if [[ -z "$model" ]]; then
    model=$(python3 -c "import json;print(json.load(open('$HOME/.claude/settings.json')).get('model') or '')" 2>/dev/null)
fi
case "$model" in
    *[Oo]pus*) model=Opus ;; *[Ss]onnet*) model=Sonnet ;; *[Hh]aiku*) model=Haiku ;;
    *[Ff]able*) model=Fable ;; "") model=Claude ;;
esac

# Usage %: the cached API value; refresh in the background when stale (>60s).
now=$(date +%s); pct=""; at=0
if [[ -r "$USAGE_CACHE" ]]; then
    pct=$(grep -m1 '^PCT=' "$USAGE_CACHE" | cut -d= -f2)
    at=$(grep -m1 '^AT='  "$USAGE_CACHE" | cut -d= -f2)
fi
(( now - ${at:-0} > 60 )) && setsid "$0" refresh-usage </dev/null >/dev/null 2>&1 &
usage=""; [[ -n "$pct" ]] && usage="${pct}%"

# Working/idle from the hook flag, if fresh.
state=idle; verb=""
if [[ -r "$HOOK" ]]; then
    hs=$(grep -m1 '^STATE=' "$HOOK" | cut -d= -f2)
    hv=$(grep -m1 '^VERB='  "$HOOK" | cut -d= -f2)
    hat=$(grep -m1 '^AT='   "$HOOK" | cut -d= -f2)
    if [[ "$hs" == working ]] && (( now - ${hat:-0} <= 180 )); then
        state=working; verb=${hv:-Cooking}
    fi
fi

printf 'STATE=%s\nMODEL=%s\nUSAGE=%s\nVERB=%s\n' "$state" "$model" "$usage" "$verb"
